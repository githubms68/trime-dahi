@@ -0,0 +1,129 @@
+/*
+ * SPDX-FileCopyrightText: 2026 Rime community
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+package com.osfans.trime.ime.voice
+
+import android.content.Context
+import android.graphics.Canvas
+import android.graphics.Color
+import android.graphics.Paint
+import android.util.AttributeSet
+import android.view.View
+import androidx.annotation.ColorInt
+import kotlin.math.ln
+import kotlin.math.max
+import kotlin.math.sin
+
+/**
+ * 实时音频波形视图。
+ *
+ * 上游 fork 基于第三方库 jaygoo/WaveLineView 实现；此处为保持工程零额外依赖，
+ * 用一个自绘的简单柱状波形替代，但对外 API 与说点啥/小企鹅保持一致：
+ * [start] / [stop] / [updateAmplitude] / [setWaveformColor]。
+ */
+class WaveformView @JvmOverloads constructor(
+    context: Context,
+    attrs: AttributeSet? = null,
+    defStyleAttr: Int = 0,
+) : View(context, attrs, defStyleAttr) {
+
+    companion object {
+        private const val AMPLITUDE_GAIN = 1.6
+        private const val AMPLITUDE_LOG_K = 18.0
+        private const val BAR_COUNT = 48
+        private const val FRAME_DELAY_MS = 40L
+    }
+
+    private val paint =
+        Paint(Paint.ANTI_ALIAS_FLAG).apply {
+            strokeCap = Paint.Cap.ROUND
+            color = Color.WHITE
+        }
+
+    @ColorInt
+    private var lineColor: Int = Color.WHITE
+
+    private var isActive = false
+    private var normalizedVolume = 0f
+    private val levels = FloatArray(BAR_COUNT)
+    private var phase = 0f
+
+    private val frameRunnable =
+        object : Runnable {
+            override fun run() {
+                if (!isActive) return
+                phase += 0.35f
+                for (i in levels.indices) {
+                    val wave = (sin((phase + i * 0.4f).toDouble()).toFloat() + 1f) / 2f
+                    val target = normalizedVolume * (0.35f + 0.65f * wave)
+                    levels[i] = max(levels[i] * 0.6f, target)
+                }
+                invalidate()
+                postDelayed(this, FRAME_DELAY_MS)
+            }
+        }
+
+    fun setWaveformColor(@ColorInt color: Int) {
+        lineColor = color
+        paint.color = color
+        invalidate()
+    }
+
+    fun updateAmplitude(amplitude: Float) {
+        if (!isActive) return
+        normalizedVolume = amplitudeToVolume(amplitude)
+    }
+
+    fun start() {
+        if (isActive) return
+        isActive = true
+        postDelayed(frameRunnable, FRAME_DELAY_MS)
+    }
+
+    fun stop() {
+        if (!isActive) return
+        isActive = false
+        removeCallbacks(frameRunnable)
+        levels.fill(0f)
+        normalizedVolume = 0f
+        invalidate()
+    }
+
+    override fun onDraw(canvas: Canvas) {
+        super.onDraw(canvas)
+        if (width <= 0 || height <= 0) return
+        paint.color = lineColor
+        paint.strokeWidth = max(2f, width / (BAR_COUNT * 2.5f))
+        val centerY = height / 2f
+        val maxHalf = height / 2f * 0.9f
+        val step = width.toFloat() / BAR_COUNT
+        for (i in levels.indices) {
+            val x = step * i + step / 2f
+            val half = max(maxHalf * levels[i], paint.strokeWidth)
+            canvas.drawLine(x, centerY - half, x, centerY + half, paint)
+        }
+    }
+
+    override fun onVisibilityChanged(
+        changedView: View,
+        visibility: Int,
+    ) {
+        super.onVisibilityChanged(changedView, visibility)
+        if (changedView == this && visibility != View.VISIBLE) {
+            stop()
+        }
+    }
+
+    override fun onDetachedFromWindow() {
+        super.onDetachedFromWindow()
+        stop()
+    }
+
+    private fun amplitudeToVolume(amplitude: Float): Float {
+        val a = (amplitude.coerceIn(0f, 1f).toDouble() * AMPLITUDE_GAIN).coerceIn(0.0, 1.0)
+        val mapped = ln(1.0 + AMPLITUDE_LOG_K * a) / ln(1.0 + AMPLITUDE_LOG_K)
+        return mapped.toFloat().coerceIn(0f, 1f)
+    }
+}
