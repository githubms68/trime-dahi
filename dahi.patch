diff --git a/build-dahi.sh b/build-dahi.sh
new file mode 100755
index 0000000..cfcd3b2
--- /dev/null
+++ b/build-dahi.sh
@@ -0,0 +1,51 @@
+#!/usr/bin/env bash
+# SPDX-FileCopyrightText: 2026 Rime community
+# SPDX-License-Identifier: GPL-3.0-or-later
+#
+# 一键编译「同文输入法大海版」（自用版，共存包名 com.osfans.trime.dahi）。
+#
+# 依赖：
+#   - JDK 25（与工程 build-logic 要求一致）
+#   - Android SDK（含 build-tools 36、platform 36）
+#   - Android NDK 28.0.13004108、CMake 3.31.6（可用 sdkmanager 安装）
+#   - git（需递归拉取子模块 librime / OpenCC 等）
+#
+# 用法：
+#   ./build-dahi.sh
+#   # 或只编译某个 ABI（更快）：
+#   BUILD_ABI=arm64-v8a ./build-dahi.sh
+set -euo pipefail
+
+export CI_NAME="${CI_NAME:-Dahi Build}"
+# 如 SDK 不在默认位置，请自行设置：
+# export ANDROID_HOME="$HOME/Android/Sdk"
+
+echo ">> 拉取原生依赖（librime / OpenCC / snappy / librime-lua ...，按 v3.3.12 锁定版本）"
+bash script/fetch-dahi-deps.sh
+
+# 可选：确保 NDK / CMake 版本与工程一致（sdkmanager 需在 PATH 中）
+# sdkmanager --install "ndk;28.0.13004108" "cmake;3.31.6"
+
+if [ ! -f keystore.properties ]; then
+  echo ">> 未发现 keystore.properties，自动生成自签名 keystore（仅本机自用）"
+  keytool -genkeypair -v -keystore dahi.keystore -alias dahi \
+    -keyalg RSA -keysize 2048 -validity 10000 \
+    -storepass dahipass -keypass dahipass \
+    -dname "CN=Dahi Trime, OU=Dahi, O=Dahi, L=City, ST=State, C=CN"
+  B64="$(base64 -w0 dahi.keystore 2>/dev/null || base64 dahi.keystore | tr -d '\n')"
+  {
+    echo "keyBase64=$B64"
+    echo "storePassword=dahipass"
+    echo "keyAlias=dahi"
+    echo "keyPassword=dahipass"
+  } > keystore.properties
+fi
+
+echo ">> 开始编译 :app:assembleRelease"
+make release
+
+echo ">> 完成。产物位于： app/build/outputs/apk/release/"
+ls -l app/build/outputs/apk/release/ || true
+echo
+echo "提示：现代手机请安装 arm64-v8a 版本；旧机型选 armeabi-v7a。"
+echo "     安装包名：com.osfans.trime.dahi（可与原版同文共存）。"
