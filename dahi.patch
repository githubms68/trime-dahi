index 0000000..169c5bf
--- /dev/null
+++ b/app/src/main/java/com/osfans/trime/data/backup/BackupManager.kt
@@ -0,0 +1,137 @@
+/*
+ * SPDX-FileCopyrightText: 2026 Rime community
+ *
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+package com.osfans.trime.data.backup
+
+import androidx.core.content.edit
+import androidx.preference.PreferenceManager
+import com.osfans.trime.BuildConfig
+import com.osfans.trime.data.db.ClipboardHelper
+import com.osfans.trime.data.db.CollectionHelper
+import com.osfans.trime.data.db.DatabaseBean
+import com.osfans.trime.ime.voice.VoiceImagery
+import com.osfans.trime.util.appContext
+import kotlinx.serialization.encodeToString
+import kotlinx.serialization.json.Json
+import kotlinx.serialization.json.JsonArray
+import kotlinx.serialization.json.JsonPrimitive
+import kotlinx.serialization.json.boolean
+import kotlinx.serialization.json.contentOrNull
+import kotlinx.serialization.json.float
+import kotlinx.serialization.json.int
+import kotlinx.serialization.json.jsonArray
+import kotlinx.serialization.json.jsonPrimitive
+import kotlinx.serialization.json.long
+
+/**
+ * 备份/还原的核心逻辑：收集首选项、剪贴板与收藏夹数据，并以加密方式编码/解码。
+ */
+object BackupManager {
+    private val json =
+        Json {
+            prettyPrint = true
+            encodeDefaults = true
+            ignoreUnknownKeys = true
+        }
+
+    suspend fun createBackup(
+        includePreferences: Boolean,
+        includeClipboard: Boolean,
+        includeCollection: Boolean,
+        includeVoiceImagery: Boolean = false,
+    ): BackupData = BackupData(
+        timestamp = System.currentTimeMillis(),
+        appVersion = BuildConfig.BUILD_VERSION_NAME,
+        preferences = if (includePreferences) exportPreferences() else null,
+        clipboard = if (includeClipboard) ClipboardHelper.exportBeans().map { it.toBackupBean() } else null,
+        collection = if (includeCollection) CollectionHelper.exportBeans().map { it.toBackupBean() } else null,
+        voiceImagery = if (includeVoiceImagery) exportVoiceImagery() else null,
+    )
+
+    fun encode(
+        data: BackupData,
+        password: CharArray,
+    ): ByteArray = BackupCrypto.encrypt(json.encodeToString(data).toByteArray(Charsets.UTF_8), password)
+
+    fun decode(
+        bytes: ByteArray,
+        password: CharArray,
+    ): BackupData = json.decodeFromString(BackupCrypto.decrypt(bytes, password).toString(Charsets.UTF_8))
+
+    suspend fun applyBackup(
+        data: BackupData,
+        restorePreferences: Boolean,
+        restoreClipboard: Boolean,
+        restoreCollection: Boolean,
+        restoreVoiceImagery: Boolean = false,
+    ) {
+        if (restorePreferences) data.preferences?.let { importPreferences(it) { key -> !key.startsWith(VoiceImagery.KEY_PREFIX) } }
+        if (restoreClipboard) data.clipboard?.let { beans -> ClipboardHelper.restoreBeans(beans.map { it.toBean() }) }
+        if (restoreCollection) data.collection?.let { beans -> CollectionHelper.restoreBeans(beans.map { it.toBean() }) }
+        if (restoreVoiceImagery) data.voiceImagery?.let { importPreferences(it) { key -> key.startsWith(VoiceImagery.KEY_PREFIX) } }
+    }
+
+    private fun exportPreferences(): Map<String, BackupPreference> = exportPreferencesByFilter { key -> !key.startsWith(VoiceImagery.KEY_PREFIX) }
+
+    /** 单独导出声情意象参数，便于备份时独立勾选。 */
+    private fun exportVoiceImagery(): Map<String, BackupPreference> = exportPreferencesByFilter { key -> key.startsWith(VoiceImagery.KEY_PREFIX) }
+
+    private fun exportPreferencesByFilter(filter: (String) -> Boolean): Map<String, BackupPreference> {
+        val shared = PreferenceManager.getDefaultSharedPreferences(appContext)
+        val result = linkedMapOf<String, BackupPreference>()
+        shared.all.forEach { (key, value) ->
+            if (!filter(key)) return@forEach
+            when (value) {
+                is Boolean -> result[key] = BackupPreference("BOOLEAN", JsonPrimitive(value))
+                is Int -> result[key] = BackupPreference("INT", JsonPrimitive(value))
+                is Long -> result[key] = BackupPreference("LONG", JsonPrimitive(value))
+                is Float -> result[key] = BackupPreference("FLOAT", JsonPrimitive(value))
+                is String -> result[key] = BackupPreference("STRING", JsonPrimitive(value))
+                is Set<*> ->
+                    result[key] =
+                        BackupPreference("STRING_SET", JsonArray(value.map { JsonPrimitive(it.toString()) }))
+            }
+        }
+        return result
+    }
+
+    private fun importPreferences(
+        preferences: Map<String, BackupPreference>,
+        filter: (String) -> Boolean = { true },
+    ) {
+        val shared = PreferenceManager.getDefaultSharedPreferences(appContext)
+        shared.edit {
+            preferences.forEach { (key, pref) ->
+                if (!filter(key)) return@forEach
+                runCatching {
+                    when (pref.type) {
+                        "BOOLEAN" -> putBoolean(key, pref.value.jsonPrimitive.boolean)
+                        "INT" -> putInt(key, pref.value.jsonPrimitive.int)
+                        "LONG" -> putLong(key, pref.value.jsonPrimitive.long)
+                        "FLOAT" -> putFloat(key, pref.value.jsonPrimitive.float)
+                        "STRING" -> putString(key, pref.value.jsonPrimitive.contentOrNull)
+                        "STRING_SET" ->
+                            putStringSet(
+                                key,
+                                pref.value.jsonArray.mapNotNull { it.jsonPrimitive.contentOrNull }.toSet(),
+                            )
+                    }
+                }
+            }
+        }
+    }
+
+    private fun DatabaseBean.toBackupBean() = BackupBean(text, html, type.name, time, pinned, orderIndex)
+
+    private fun BackupBean.toBean() = DatabaseBean(
+        text = text,
+        html = html,
+        type = runCatching { DatabaseBean.BeanType.valueOf(type) }.getOrDefault(DatabaseBean.BeanType.TEXT),
+        time = time,
+        pinned = pinned,
+        orderIndex = orderIndex,
+    )
+}
diff --git a/app/src/main/java/com/osfans/trime/data/backup/BackupRestoreDialog.kt b/app/src/main/java/com/osfans/trime/data/backup/BackupRestoreDialog.kt
