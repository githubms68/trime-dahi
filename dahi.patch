+/*
+ * SPDX-FileCopyrightText: 2015 - 2026 Rime community
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+package com.osfans.trime.ime.core
+
+import android.content.Context
+import android.content.SharedPreferences
+import androidx.core.content.edit
+import androidx.preference.PreferenceManager
+import com.osfans.trime.util.appContext
+import kotlin.math.roundToInt
+
+/**
+ * 悬浮键盘的共享状态。
+ *
+ * - **开关与缩放比例**存放在默认 SharedPreferences（键 `floating_keyboard_enabled` /
+ *   `floating_keyboard_scale`），与设置页里由 [com.osfans.trime.data.prefs.AppPrefs.Keyboard]
+ *   自动生成的开关、滑块共用同一份存储，因此两边天然同步，也会随「备份与还原」一起导出。
+ * - **位置记忆**放在独立文件，避免与普通偏好混在一起。
+ */
+object FloatingKeyboard {
+    private const val PREFS_NAME = "dahi_floating_keyboard"
+    private const val KEY_X = "x"
+    private const val KEY_Y = "y"
+
+    private const val LEGACY_KEY_ENABLED = "enabled"
+    private const val LEGACY_KEY_SCALE = "scale"
+
+    const val KEY_ENABLED = "floating_keyboard_enabled"
+    const val KEY_SCALE = "floating_keyboard_scale"
+
+    const val DEFAULT_SCALE_PERCENT = 90
+    const val MIN_SCALE_PERCENT = 50
+    const val MAX_SCALE_PERCENT = 100
+
+    const val DEFAULT_SCALE = DEFAULT_SCALE_PERCENT / 100f
+    val MIN_SCALE = MIN_SCALE_PERCENT / 100f
+    val MAX_SCALE = MAX_SCALE_PERCENT / 100f
+
+    const val SCALE_STEP = 0.1f
+
+    private val prefs: SharedPreferences by lazy {
+        appContext.getSharedPreferences(PREFS_NAME, Context.MODE_PRIVATE)
+    }
+
+    private val uiPrefs: SharedPreferences by lazy {
+        PreferenceManager.getDefaultSharedPreferences(appContext).also { migrateLegacyState(it) }
+    }
+
+    /** 旧版本把开关/缩放放在独立文件里，这里做一次性迁移，避免升级后丢失原有状态。 */
+    private fun migrateLegacyState(target: SharedPreferences) {
+        if (!prefs.contains(LEGACY_KEY_ENABLED)) return
+        if (target.contains(KEY_ENABLED)) return
+        target.edit {
+            putBoolean(KEY_ENABLED, prefs.getBoolean(LEGACY_KEY_ENABLED, false))
+            if (prefs.contains(LEGACY_KEY_SCALE)) {
+                putInt(KEY_SCALE, (prefs.getFloat(LEGACY_KEY_SCALE, DEFAULT_SCALE) * 100f).roundToInt())
+            }
+        }
+    }
+
+    fun isEnabled(): Boolean = uiPrefs.getBoolean(KEY_ENABLED, false)
+
+    fun setEnabled(value: Boolean) {
+        uiPrefs.edit { putBoolean(KEY_ENABLED, value) }
+    }
+
+    fun toggle() {
+        setEnabled(!isEnabled())
+    }
+
+    /** 缩放比例（百分数，50–100）。 */
+    fun getScalePercent(): Int = uiPrefs.getInt(KEY_SCALE, DEFAULT_SCALE_PERCENT).coerceIn(MIN_SCALE_PERCENT, MAX_SCALE_PERCENT)
+
+    fun setScalePercent(value: Int) {
+        uiPrefs.edit { putInt(KEY_SCALE, value.coerceIn(MIN_SCALE_PERCENT, MAX_SCALE_PERCENT)) }
+    }
+
+    fun getScale(): Float = getScalePercent() / 100f
+
+    fun setScale(value: Float) {
+        setScalePercent((value * 100f).roundToInt())
+    }
+
+    fun getX(): Float = prefs.getFloat(KEY_X, 0f)
+
+    fun getY(): Float = prefs.getFloat(KEY_Y, 0f)
+
+    fun setPosition(
+        x: Float,
+        y: Float,
+    ) {
+        prefs.edit {
+            putFloat(KEY_X, x)
+            putFloat(KEY_Y, y)
+        }
+    }
+
+    fun registerListener(listener: SharedPreferences.OnSharedPreferenceChangeListener) {
+        uiPrefs.registerOnSharedPreferenceChangeListener(listener)
+    }
+
+    fun unregisterListener(listener: SharedPreferences.OnSharedPreferenceChangeListener) {
+        uiPrefs.unregisterOnSharedPreferenceChangeListener(listener)
+    }
+}
