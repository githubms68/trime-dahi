+/*
+ * SPDX-FileCopyrightText: 2026 Rime community
+ *
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+package com.osfans.trime.data.backup
+
+import java.security.SecureRandom
+import javax.crypto.Cipher
+import javax.crypto.SecretKeyFactory
+import javax.crypto.spec.GCMParameterSpec
+import javax.crypto.spec.PBEKeySpec
+import javax.crypto.spec.SecretKeySpec
+
+/**
+ * 备份文件的加密封装。
+ *
+ * 文件格式（大端无关，按字节顺序）：
+ * ```
+ * magic(8B) | version(1B) | salt(16B) | iv(12B) | AES-GCM(ciphertext + 16B tag)
+ * ```
+ *
+ * - magic 固定为 `DAHIBAK1`，用于快速识别本版本导出的加密备份；
+ * - 密钥由用户密码经 PBKDF2-HMAC-SHA256（回退 SHA1）派生，迭代 200000 次，256 bit；
+ * - 内容使用 AES-256-GCM 认证加密，附带认证标签，可同时防篡改与防未授权读取。
+ *
+ * 说明：本实现**不导出任何明文**，从设计上避免剪贴板/收藏夹/首选项内容被其它应用随意读取。
+ */
+object BackupCrypto {
+    private const val MAGIC = "DAHIBAK1"
+    private const val VERSION: Byte = 1
+    private const val SALT_LEN = 16
+    private const val IV_LEN = 12
+    private const val TAG_BITS = 128
+    private const val ITERATIONS = 200_000
+    private const val KEY_BITS = 256
+    private const val TRANSFORMATION = "AES/GCM/NoPadding"
+
+    private val random = SecureRandom()
+
+    /** 文件头后偏移量：magic + version。 */
+    private val HEADER_LEN = MAGIC.length + 1
+
+    fun isEncrypted(data: ByteArray): Boolean =
+        data.size > HEADER_LEN + SALT_LEN + IV_LEN &&
+            String(data, 0, MAGIC.length, Charsets.US_ASCII) == MAGIC
+
+    fun encrypt(
+        plain: ByteArray,
+        password: CharArray,
+    ): ByteArray {
+        val salt = ByteArray(SALT_LEN).also { random.nextBytes(it) }
+        val iv = ByteArray(IV_LEN).also { random.nextBytes(it) }
+        val cipher = Cipher.getInstance(TRANSFORMATION)
+        cipher.init(Cipher.ENCRYPT_MODE, deriveKey(password, salt), GCMParameterSpec(TAG_BITS, iv))
+        val cipherText = cipher.doFinal(plain)
+        return buildList {
+            add(MAGIC.toByteArray(Charsets.US_ASCII))
+            add(byteArrayOf(VERSION))
+            add(salt)
+            add(iv)
+            add(cipherText)
+        }.fold(ByteArray(0)) { acc, bytes -> acc + bytes }
+    }
+
+    fun decrypt(
+        data: ByteArray,
+        password: CharArray,
+    ): ByteArray {
+        require(isEncrypted(data)) { "Not a DAHI encrypted backup file" }
+        var offset = MAGIC.length
+        val fileVersion = data[offset]
+        offset += 1
+        require(fileVersion <= VERSION) { "Unsupported backup version: $fileVersion" }
+        val salt = data.copyOfRange(offset, offset + SALT_LEN)
+        offset += SALT_LEN
+        val iv = data.copyOfRange(offset, offset + IV_LEN)
+        offset += IV_LEN
+        val cipherText = data.copyOfRange(offset, data.size)
+        val cipher = Cipher.getInstance(TRANSFORMATION)
+        cipher.init(Cipher.DECRYPT_MODE, deriveKey(password, salt), GCMParameterSpec(TAG_BITS, iv))
+        return cipher.doFinal(cipherText)
+    }
+
+    private fun deriveKey(
+        password: CharArray,
+        salt: ByteArray,
+    ): SecretKeySpec {
+        // PBKDF2WithHmacSHA256 自 Android 8.0 起可用；更低版本回退到 SHA1。
+        val factory =
+            runCatching { SecretKeyFactory.getInstance("PBKDF2WithHmacSHA256") }
+                .getOrElse { SecretKeyFactory.getInstance("PBKDF2WithHmacSHA1") }
+        val spec = PBEKeySpec(password, salt, ITERATIONS, KEY_BITS)
+        return try {
+            SecretKeySpec(factory.generateSecret(spec).encoded, "AES")
+        } finally {
+            spec.clearPassword()
+        }
+    }
+}
