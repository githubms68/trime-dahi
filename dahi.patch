+/*
+ * SPDX-FileCopyrightText: 2026 Rime community
+ *
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+package com.osfans.trime.data.backup
+
+import kotlinx.serialization.Serializable
+import kotlinx.serialization.json.JsonElement
+
+/**
+ * 备份数据模型。
+ *
+ * 出于隐私考虑，序列化后的明文 JSON 在落盘/导出前会整体加密（见 [BackupCrypto]），
+ * 因此磁盘上的备份文件不会以明文形式暴露剪贴板、收藏夹或首选项内容。
+ */
+@Serializable
+data class BackupData(
+    val format: String = FORMAT,
+    val version: Int = CURRENT_VERSION,
+    val timestamp: Long = System.currentTimeMillis(),
+    val appVersion: String? = null,
+    val preferences: Map<String, BackupPreference>? = null,
+    val clipboard: List<BackupBean>? = null,
+    val collection: List<BackupBean>? = null,
+    /** 声情意象（语音动效）参数，键前缀见 [com.osfans.trime.ime.voice.VoiceImagery.KEY_PREFIX]。 */
+    val voiceImagery: Map<String, BackupPreference>? = null,
+) {
+    companion object {
+        const val FORMAT = "dahi-trime-backup"
+        const val CURRENT_VERSION = 1
+    }
+}
+
+/** 单条偏好设置：[type] 为存储类型名，[value] 为对应的 JSON 值。 */
+@Serializable
+data class BackupPreference(
+    val type: String,
+    val value: JsonElement,
+)
+
+/** 剪贴板/收藏夹条目。 */
+@Serializable
+data class BackupBean(
+    val text: String? = null,
+    val html: String? = null,
+    val type: String = "TEXT",
+    val time: Long = 0L,
+    val pinned: Boolean = false,
+    val orderIndex: Int = 0,
+)
diff --git a/app/src/main/java/com/osfans/trime/data/backup/BackupManager.kt b/app/src/main/java/com/osfans/trime/data/backup/BackupManager.kt
