diff --git a/app/src/main/java/com/osfans/trime/ui/main/settings/VoiceImagerySettingsFragment.kt b/app/src/main/java/com/osfans/trime/ui/main/settings/VoiceImagerySettingsFragment.kt
new file mode 100755
index 0000000..5d51123
--- /dev/null
+++ b/app/src/main/java/com/osfans/trime/ui/main/settings/VoiceImagerySettingsFragment.kt
@@ -0,0 +1,269 @@
+/*
+ * SPDX-FileCopyrightText: 2026 Rime community
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+package com.osfans.trime.ui.main.settings
+
+import android.os.Bundle
+import android.view.LayoutInflater
+import android.view.View
+import android.view.ViewGroup
+import android.widget.SeekBar
+import android.widget.TextView
+import android.widget.Toast
+import androidx.appcompat.app.AlertDialog
+import androidx.appcompat.widget.SwitchCompat
+import androidx.fragment.app.Fragment
+import androidx.recyclerview.widget.ItemTouchHelper
+import androidx.recyclerview.widget.LinearLayoutManager
+import androidx.recyclerview.widget.RecyclerView
+import com.osfans.trime.R
+import com.osfans.trime.ime.voice.VoiceImagery
+import com.osfans.trime.ime.voice.VoiceImageryStyle
+import com.osfans.trime.util.applyNavBarInsetsBottomPadding
+import splitties.resources.styledColor
+import kotlin.math.abs
+import kotlin.math.min
+
+/**
+ * 「声情意象」系统设置页：顶部为（恢复初始设置 + 参数区），其后为 11 个动效选项
+ * （点按选择、长按拖动排序；左侧 1–11 序号列固定按位置编号，只有右侧动效条在移动）。
+ */
+class VoiceImagerySettingsFragment : Fragment() {
+    override fun onCreateView(
+        inflater: LayoutInflater,
+        container: ViewGroup?,
+        savedInstanceState: Bundle?,
+    ): View = inflater.inflate(R.layout.fragment_dahi_voice_imagery, container, false)
+
+    override fun onViewCreated(
+        view: View,
+        savedInstanceState: Bundle?,
+    ) {
+        super.onViewCreated(view, savedInstanceState)
+        val list = view.findViewById<RecyclerView>(R.id.dahi_vi_list)
+        list.layoutManager = LinearLayoutManager(requireContext())
+        list.applyNavBarInsetsBottomPadding()
+        // 关闭条目动画：拖动排序时位置即时交换，不会出现多个条目"纠缠"在一起
+        list.itemAnimator = null
+
+        val adapter = VoiceImageryAdapter { confirmReset() }
+        list.adapter = adapter
+
+        val callback =
+            object : ItemTouchHelper.SimpleCallback(ItemTouchHelper.UP or ItemTouchHelper.DOWN, 0) {
+                override fun getMovementFlags(
+                    recyclerView: RecyclerView,
+                    viewHolder: RecyclerView.ViewHolder,
+                ): Int = if (viewHolder.itemViewType == VoiceImageryAdapter.TYPE_OPTION) {
+                    makeMovementFlags(ItemTouchHelper.UP or ItemTouchHelper.DOWN, 0)
+                } else {
+                    makeMovementFlags(0, 0)
+                }
+
+                override fun onMove(
+                    recyclerView: RecyclerView,
+                    viewHolder: RecyclerView.ViewHolder,
+                    target: RecyclerView.ViewHolder,
+                ): Boolean {
+                    val from = viewHolder.bindingAdapterPosition
+                    val to = target.bindingAdapterPosition
+                    if (from <= 0 || to <= 0) return false
+                    return adapter.moveItem(from - 1, to - 1)
+                }
+
+                override fun onSwiped(
+                    viewHolder: RecyclerView.ViewHolder,
+                    direction: Int,
+                ) = Unit
+
+                override fun onSelectedChanged(
+                    viewHolder: RecyclerView.ViewHolder?,
+                    actionState: Int,
+                ) {
+                    super.onSelectedChanged(viewHolder, actionState)
+                    viewHolder?.itemView?.alpha = if (actionState == ItemTouchHelper.ACTION_STATE_DRAG) 0.85f else 1f
+                }
+
+                override fun clearView(
+                    recyclerView: RecyclerView,
+                    viewHolder: RecyclerView.ViewHolder,
+                ) {
+                    super.clearView(recyclerView, viewHolder)
+                    viewHolder.itemView.alpha = 1f
+                    // 只落盘，不做任何 notify：拖动收尾时 RecyclerView 可能正在布局/滚动，
+                    // 此时通知会抛 "Cannot call this method while RecyclerView is computing a layout or scrolling"
+                    adapter.persistOrder()
+                }
+            }
+        ItemTouchHelper(callback).attachToRecyclerView(list)
+    }
+
+    private fun confirmReset() {
+        val ctx = requireContext()
+        AlertDialog
+            .Builder(ctx)
+            .setTitle(R.string.dahi_vi_reset)
+            .setMessage(R.string.dahi_vi_reset_confirm_message)
+            .setNegativeButton(android.R.string.cancel, null)
+            .setPositiveButton(android.R.string.ok) { _, _ ->
+                VoiceImagery.resetToDefaults()
+                val current = view?.findViewById<RecyclerView>(R.id.dahi_vi_list)?.adapter as? VoiceImageryAdapter
+                current?.reload()
+                Toast.makeText(ctx, R.string.dahi_vi_reset_done, Toast.LENGTH_SHORT).show()
+            }.show()
+    }
+}
+
+/** 声情意象设置页的列表：第 0 项为顶部参数区，其后为 11 个可拖动排序的动效选项。 */
+class VoiceImageryAdapter(
+    private val onReset: () -> Unit,
+) : RecyclerView.Adapter<RecyclerView.ViewHolder>() {
+    companion object {
+        const val TYPE_HEADER = 0
+        const val TYPE_OPTION = 1
+    }
+
+    private val items: MutableList<VoiceImageryStyle> = VoiceImagery.order().toMutableList()
+
+    override fun getItemCount(): Int = items.size + 1
+
+    override fun getItemViewType(position: Int): Int = if (position == 0) TYPE_HEADER else TYPE_OPTION
+
+    override fun onCreateViewHolder(
+        parent: ViewGroup,
+        viewType: Int,
+    ): RecyclerView.ViewHolder {
+        val inflater = LayoutInflater.from(parent.context)
+        return if (viewType == TYPE_HEADER) {
+            HeaderHolder(inflater.inflate(R.layout.item_dahi_vi_header, parent, false))
+        } else {
+            OptionHolder(inflater.inflate(R.layout.item_dahi_vi_option, parent, false))
+        }
+    }
+
+    override fun onBindViewHolder(
+        holder: RecyclerView.ViewHolder,
+        position: Int,
+    ) {
+        when (holder) {
+            is HeaderHolder -> holder.bind()
+            is OptionHolder -> holder.bind(items[position - 1], position)
+        }
+    }
+
+    fun moveItem(
+        from: Int,
+        to: Int,
+    ): Boolean {
+        if (from == to) return false
+        if (from !in items.indices || to !in items.indices) return false
+        items.add(to, items.removeAt(from))
+        notifyItemMoved(from, to)
+        // 序号与文案都绑在行上，而 notifyItemMoved 只会搬动视图、不会重新绑定，
+        // 因此必须让受影响的行重绑一次，否则序号/文案会残留错乱。
+        val start = min(from, to)
+        notifyItemRangeChanged(start, abs(to - from) + 1)
+        return true
+    }
+
+    fun persistOrder() {
+        VoiceImagery.setOrder(items)
+    }
+
+    /** 恢复初始设置后重新载入并刷新。 */
+    fun reload() {
+        items.clear()
+        items.addAll(VoiceImagery.order())
+        notifyDataSetChanged()
+    }
+
+    inner class HeaderHolder(
+        root: View,
+    ) : RecyclerView.ViewHolder(root) {
+        private val resetRow: View = root.findViewById(R.id.dahi_vi_reset_row)
+        private val maxAmplitude: SeekBar = root.findViewById(R.id.dahi_vi_header_max_amp)
+        private val maxAmplitudeValue: TextView = root.findViewById(R.id.dahi_vi_header_max_amp_value)
+        private val sensitivity: SeekBar = root.findViewById(R.id.dahi_vi_header_sensitivity)
+        private val sensitivityValue: TextView = root.findViewById(R.id.dahi_vi_header_sensitivity_value)
+        private val toolbarSwitch: SwitchCompat = root.findViewById(R.id.dahi_vi_header_toolbar_switch)
+
+        fun bind() {
+            resetRow.setOnClickListener { onReset() }
+
+            maxAmplitude.max = 100 - VoiceImagery.MIN_MAX_AMPLITUDE
+            maxAmplitude.progress = VoiceImagery.maxAmplitude() - VoiceImagery.MIN_MAX_AMPLITUDE
+            maxAmplitudeValue.text = "${VoiceImagery.maxAmplitude()}%"
+            maxAmplitude.setOnSeekBarChangeListener(
+                object : SeekBar.OnSeekBarChangeListener {
+                    override fun onProgressChanged(
+                        seekBar: SeekBar,
+                        progress: Int,
+                        fromUser: Boolean,
+                    ) {
+                        val value = VoiceImagery.MIN_MAX_AMPLITUDE + progress
+                        maxAmplitudeValue.text = "$value%"
+                        VoiceImagery.setMaxAmplitude(value)
+                    }
+
+                    override fun onStartTrackingTouch(seekBar: SeekBar) = Unit
+
+                    override fun onStopTrackingTouch(seekBar: SeekBar) = Unit
+                },
+            )
+
+            sensitivity.max = 100
+            sensitivity.progress = VoiceImagery.sensitivity()
+            sensitivityValue.text = "${VoiceImagery.sensitivity()}%"
+            sensitivity.setOnSeekBarChangeListener(
+                object : SeekBar.OnSeekBarChangeListener {
+                    override fun onProgressChanged(
+                        seekBar: SeekBar,
+                        progress: Int,
+                        fromUser: Boolean,
+                    ) {
+                        sensitivityValue.text = "$progress%"
+                        VoiceImagery.setSensitivity(progress)
+                    }
+
+                    override fun onStartTrackingTouch(seekBar: SeekBar) = Unit
+
+                    override fun onStopTrackingTouch(seekBar: SeekBar) = Unit
+                },
+            )
+
+            toolbarSwitch.isChecked = VoiceImagery.toolbarButtonEnabled()
+            toolbarSwitch.setOnCheckedChangeListener { _, checked ->
+                VoiceImagery.setToolbarButtonEnabled(checked)
+            }
+        }
+    }
+
+    inner class OptionHolder(
+        root: View,
+    ) : RecyclerView.ViewHolder(root) {
+        private val index: TextView = root.findViewById(R.id.dahi_vi_option_index)
+        private val name: TextView = root.findViewById(R.id.dahi_vi_option_name)
+        private val note: TextView = root.findViewById(R.id.dahi_vi_option_note)
+        private val check: TextView = root.findViewById(R.id.dahi_vi_option_check)
+
+        fun bind(
+            style: VoiceImageryStyle,
+            position: Int,
+        ) {
+            val ctx = itemView.context
+            // 序号列按"行位置"编号：永远是 1–11 顺序排列，移动的只是右侧动效条
+            index.text = position.toString()
+            name.text = ctx.getString(style.nameRes)
+            note.text = ctx.getString(style.noteRes)
+            val selected = VoiceImagery.current() == style
+            check.text = if (selected) "✓" else ""
+            check.setTextColor(ctx.styledColor(android.R.attr.colorAccent))
+            itemView.setOnClickListener {
+                VoiceImagery.setCurrent(style)
+                notifyItemRangeChanged(1, items.size)
+            }
+        }
+    }
+}
