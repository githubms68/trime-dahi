@@ -0,0 +1,294 @@
+/*
+ * SPDX-FileCopyrightText: 2026 Rime community
+ *
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+package com.osfans.trime.data.backup
+
+import android.net.Uri
+import android.text.InputType
+import android.view.ViewGroup
+import android.widget.EditText
+import android.widget.FrameLayout
+import androidx.activity.result.ActivityResultLauncher
+import androidx.activity.result.contract.ActivityResultContracts
+import androidx.annotation.StringRes
+import androidx.appcompat.app.AlertDialog
+import androidx.fragment.app.Fragment
+import androidx.lifecycle.lifecycleScope
+import com.osfans.trime.R
+import com.osfans.trime.ui.common.withLoadingDialog
+import com.osfans.trime.util.toast
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.withContext
+
+/**
+ * 设置页「备份与还原」的交互入口。
+ *
+ * 备份文件始终为加密格式（见 [BackupCrypto]），导出前需由用户设置密码；
+ * 还原时需输入密码解密。任何情况下都不会导出明文。
+ */
+class BackupRestoreDialog(
+    private val fragment: Fragment,
+) {
+    companion object {
+        private const val MIME = "application/octet-stream"
+    }
+
+    private lateinit var saveLauncher: ActivityResultLauncher<String>
+    private lateinit var openLauncher: ActivityResultLauncher<Array<String>>
+
+    private var backupInProgress = false
+    private var restoreInProgress = false
+
+    /** 已加密、待写入用户所选文件的字节。 */
+    private var pendingBackupBytes: ByteArray? = null
+
+    fun setupLaunchers() {
+        saveLauncher =
+            fragment.registerForActivityResult(ActivityResultContracts.CreateDocument(MIME)) { uri ->
+                if (uri != null) handleBackupSave(uri)
+            }
+        openLauncher =
+            fragment.registerForActivityResult(ActivityResultContracts.OpenDocument()) { uri ->
+                if (uri != null) handleRestoreOpen(uri)
+            }
+    }
+
+    fun showBackupDialog() {
+        if (backupInProgress) return
+        val ctx = fragment.requireContext()
+        val items =
+            arrayOf(
+                ctx.getString(R.string.dahi_backup_pref),
+                ctx.getString(R.string.dahi_backup_clipboard),
+                ctx.getString(R.string.dahi_backup_collection),
+                ctx.getString(R.string.dahi_backup_voice_imagery),
+            )
+        val checked = booleanArrayOf(true, true, true, true)
+        AlertDialog
+            .Builder(ctx)
+            .setTitle(R.string.dahi_backup_select_items)
+            .setMultiChoiceItems(items, checked) { _, which, isChecked ->
+                checked[which] = isChecked
+            }.setNegativeButton(android.R.string.cancel, null)
+            .setPositiveButton(android.R.string.ok) { _, _ ->
+                if (!checked.any { it }) {
+                    ctx.toast(R.string.dahi_backup_empty_selection)
+                    return@setPositiveButton
+                }
+                askPassword(R.string.dahi_backup_set_password) { password ->
+                    performBackup(checked[0], checked[1], checked[2], checked[3], password)
+                }
+            }.show()
+    }
+
+    fun showRestoreDialog() {
+        if (restoreInProgress) return
+        openLauncher.launch(arrayOf(MIME, "application/octet-stream", "*/*"))
+    }
+
+    private fun performBackup(
+        includePreferences: Boolean,
+        includeClipboard: Boolean,
+        includeCollection: Boolean,
+        includeVoiceImagery: Boolean,
+        password: CharArray,
+    ) {
+        if (backupInProgress) return
+        backupInProgress = true
+        val ctx = fragment.requireContext()
+        fragment.lifecycleScope.launch {
+            var encrypted: ByteArray? = null
+            runCatching {
+                withLoadingDialog(ctx) {
+                    withContext(Dispatchers.IO) {
+                        val data =
+                            BackupManager.createBackup(
+                                includePreferences = includePreferences,
+                                includeClipboard = includeClipboard,
+                                includeCollection = includeCollection,
+                                includeVoiceImagery = includeVoiceImagery,
+                            )
+                        encrypted = BackupManager.encode(data, password)
+                    }
+                }
+            }
+            val bytes = encrypted
+            if (bytes == null) {
+                ctx.toast(R.string.dahi_backup_failure)
+                backupInProgress = false
+                return@launch
+            }
+            pendingBackupBytes = bytes
+            saveLauncher.launch("trime_dahi_backup_${System.currentTimeMillis()}.dahibak")
+        }
+    }
+
+    private fun handleBackupSave(uri: Uri) {
+        val data = pendingBackupBytes
+        pendingBackupBytes = null
+        val ctx = fragment.requireContext()
+        if (data == null) {
+            ctx.toast(R.string.dahi_backup_failure)
+            backupInProgress = false
+            return
+        }
+        fragment.lifecycleScope.launch {
+            val ok =
+                withContext(Dispatchers.IO) {
+                    runCatching {
+                        ctx.contentResolver.openOutputStream(uri)?.use { it.write(data) }
+                            ?: error("No output stream for uri")
+                    }.isSuccess
+                }
+            ctx.toast(if (ok) R.string.dahi_backup_success else R.string.dahi_backup_failure)
+            backupInProgress = false
+        }
+    }
+
+    private fun handleRestoreOpen(uri: Uri) {
+        if (restoreInProgress) return
+        val ctx = fragment.requireContext()
+        fragment.lifecycleScope.launch {
+            val bytes =
+                withContext(Dispatchers.IO) {
+                    runCatching {
+                        ctx.contentResolver.openInputStream(uri)?.use { it.readBytes() }
+                    }.getOrNull()
+                }
+            if (bytes == null || bytes.isEmpty() || !BackupCrypto.isEncrypted(bytes)) {
+                ctx.toast(R.string.dahi_restore_invalid_file)
+                return@launch
+            }
+            askPassword(R.string.dahi_backup_enter_password) { password ->
+                performRestore(bytes, password)
+            }
+        }
+    }
+
+    private fun performRestore(
+        bytes: ByteArray,
+        password: CharArray,
+    ) {
+        restoreInProgress = true
+        val ctx = fragment.requireContext()
+        fragment.lifecycleScope.launch {
+            var decoded: BackupData? = null
+            runCatching {
+                withLoadingDialog(ctx) {
+                    withContext(Dispatchers.IO) {
+                        decoded = BackupManager.decode(bytes, password)
+                    }
+                }
+            }
+            val data = decoded
+            if (data == null) {
+                ctx.toast(R.string.dahi_restore_wrong_password)
+                restoreInProgress = false
+                return@launch
+            }
+            showRestoreItems(data)
+        }
+    }
+
+    private fun showRestoreItems(data: BackupData) {
+        val ctx = fragment.requireContext()
+        val items =
+            arrayOf(
+                ctx.getString(R.string.dahi_backup_pref),
+                ctx.getString(R.string.dahi_backup_clipboard),
+                ctx.getString(R.string.dahi_backup_collection),
+                ctx.getString(R.string.dahi_backup_voice_imagery),
+            )
+        val available =
+            booleanArrayOf(
+                data.preferences != null,
+                data.clipboard != null,
+                data.collection != null,
+                data.voiceImagery != null,
+            )
+        val checked = available.copyOf()
+        AlertDialog
+            .Builder(ctx)
+            .setTitle(R.string.dahi_restore_select_items)
+            .setMessage(R.string.dahi_restore_replace_warning)
+            .setMultiChoiceItems(items, checked) { _, which, isChecked ->
+                checked[which] = isChecked
+            }.setNegativeButton(android.R.string.cancel, null)
+            .setPositiveButton(android.R.string.ok) { _, _ ->
+                val restorePref = checked[0] && available[0]
+                val restoreClip = checked[1] && available[1]
+                val restoreColl = checked[2] && available[2]
+                val restoreVoice = checked[3] && available[3]
+                if (!(restorePref || restoreClip || restoreColl || restoreVoice)) {
+                    ctx.toast(R.string.dahi_backup_empty_selection)
+                    return@setPositiveButton
+                }
+                applyRestore(data, restorePref, restoreClip, restoreColl, restoreVoice)
+            }.show()
+    }
+
+    private fun applyRestore(
+        data: BackupData,
+        restorePreferences: Boolean,
+        restoreClipboard: Boolean,
+        restoreCollection: Boolean,
+        restoreVoiceImagery: Boolean,
+    ) {
+        val ctx = fragment.requireContext()
+        fragment.lifecycleScope.launch {
+            val ok =
+                runCatching {
+                    withLoadingDialog(ctx) {
+                        withContext(Dispatchers.IO) {
+                            BackupManager.applyBackup(
+                                data,
+                                restorePreferences,
+                                restoreClipboard,
+                                restoreCollection,
+                                restoreVoiceImagery,
+                            )
+                        }
+                    }
+                }.isSuccess
+            ctx.toast(if (ok) R.string.dahi_restore_success else R.string.dahi_restore_failure)
+            restoreInProgress = false
+        }
+    }
+
+    private fun askPassword(
+        @StringRes title: Int,
+        onPassword: (CharArray) -> Unit,
+    ) {
+        val ctx = fragment.requireContext()
+        val input =
+            EditText(ctx).apply {
+                inputType = InputType.TYPE_CLASS_TEXT or InputType.TYPE_TEXT_VARIATION_PASSWORD
+                hint = ctx.getString(R.string.dahi_backup_password_hint)
+                setSingleLine()
+            }
+        val margin = (24 * ctx.resources.displayMetrics.density).toInt()
+        val container =
+            FrameLayout(ctx).apply {
+                addView(
+                    input,
+                    FrameLayout.LayoutParams(
+                        ViewGroup.LayoutParams.MATCH_PARENT,
+                        ViewGroup.LayoutParams.WRAP_CONTENT,
+                    ).apply { setMargins(margin, 0, margin, 0) },
+                )
+            }
+        AlertDialog
+            .Builder(ctx)
+            .setTitle(title)
+            .setView(container)
+            .setNegativeButton(android.R.string.cancel, null)
+            .setPositiveButton(android.R.string.ok) { _, _ ->
+                val text = input.text?.toString().orEmpty()
+                if (text.isNotEmpty()) onPassword(text.toCharArray())
+            }.show()
+    }
+}
diff --git a/app/src/main/java/com/osfans/trime/data/db/ClipboardHelper.kt b/app/src/main/java/com/osfans/trime/data/db/ClipboardHelper.kt
