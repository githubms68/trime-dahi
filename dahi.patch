@@ -0,0 +1,74 @@
+# SPDX-FileCopyrightText: 2026 Rime community
+#
+# SPDX-License-Identifier: GPL-3.0-or-later
+#
+# 一键在 GitHub Actions 上编译「同文输入法大海版」（自用版）。
+# 用法：把本仓库（含本文件）推到自己的 GitHub 仓库，
+#   然后 Actions -> "Build Dahi Trime APK" -> Run workflow。
+# 编译完成后在本次运行的 Artifacts 中下载 APK。
+# 原生依赖（librime/OpenCC/...）由 script/fetch-dahi-deps.sh 按 v3.3.12 锁定版本自动拉取，
+# 因此**无需**一并上传 git 子模块；签名用自签名 keystore，构建时自动生成，**无需配置任何 Secrets**。
+
+name: Build Dahi Trime APK
+
+on:
+  workflow_dispatch:
+  push:
+    branches:
+      - develop
+      - main
+      - dahi
+
+env:
+  CI_NAME: Dahi Build
+
+jobs:
+  build:
+    runs-on: ubuntu-26.04
+    steps:
+      - name: Checkout
+        uses: actions/checkout@v7
+        with:
+          submodules: false
+          fetch-depth: 0
+
+      - name: 拉取原生依赖（按 v3.3.12 锁定版本）
+        run: bash script/fetch-dahi-deps.sh
+
+      - name: Setup Java
+        uses: actions/setup-java@v6
+        with:
+          distribution: temurin
+          java-version: 25
+          cache: gradle
+
+      - name: Setup Android SDK
+        uses: android-actions/setup-android@v4
+
+      - name: Install CMake
+        run: |
+          sdkmanager --install "cmake;3.31.6"
+
+      - name: Generate self-signed keystore
+        run: |
+          keytool -genkeypair -v -keystore dahi.keystore -alias dahi \
+            -keyalg RSA -keysize 2048 -validity 10000 \
+            -storepass dahipass -keypass dahipass \
+            -dname "CN=Dahi Trime, OU=Dahi, O=Dahi, L=City, ST=State, C=CN"
+          B64=$(base64 -w0 dahi.keystore)
+          {
+            echo "keyBase64=$B64"
+            echo "storePassword=dahipass"
+            echo "keyAlias=dahi"
+            echo "keyPassword=dahipass"
+          } > keystore.properties
+
+      - name: Build release APKs
+        run: make release
+
+      - name: Upload APKs
+        uses: actions/upload-artifact@v4
+        with:
+          name: dahi-trime-apk
+          path: app/build/outputs/apk/release/*.apk
+          if-no-files-found: error
