index 0000000..5fd49e9
--- /dev/null
+++ b/app/src/main/java/com/osfans/trime/ime/clipboard/ClipboardSearchOverlay.kt
@@ -0,0 +1,242 @@
+/*
+ * SPDX-FileCopyrightText: 2026 Rime community
+ *
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+package com.osfans.trime.ime.clipboard
+
+import android.content.Context
+import android.graphics.Color
+import android.graphics.drawable.Drawable
+import android.graphics.drawable.GradientDrawable
+import android.text.TextUtils
+import android.util.TypedValue
+import android.view.Gravity
+import android.view.View
+import android.view.ViewGroup
+import android.widget.ImageView
+import android.widget.LinearLayout
+import android.widget.TextView
+import androidx.lifecycle.lifecycleScope
+import androidx.recyclerview.widget.LinearLayoutManager
+import androidx.recyclerview.widget.RecyclerView
+import com.osfans.trime.R
+import com.osfans.trime.data.db.ClipboardHelper
+import com.osfans.trime.data.db.CollectionHelper
+import com.osfans.trime.data.db.DatabaseBean
+import com.osfans.trime.data.theme.ColorManager
+import com.osfans.trime.data.theme.Theme
+import com.osfans.trime.ime.core.TrimeInputMethodService
+import com.osfans.trime.ime.keyboard.KeyboardWindow
+import com.osfans.trime.ime.window.BoardWindowManager
+import kotlinx.coroutines.Job
+import kotlinx.coroutines.launch
+
+/**
+ * 剪贴板 / 收藏夹的搜索浮层。
+ *
+ * 背景：打开剪贴板时，同文会把「键盘窗口」整体替换掉（见 [BoardWindowManager.attachWindow]），
+ * 因此剪贴板窗口里的输入框根本收不到键盘——键盘已不在屏幕上。
+ *
+ * 本浮层在「键盘已重新显示」的前提下，贴在键盘上方：
+ * 用户用同文键盘输入，纯文本 / 退格经由 [ClipboardSearchBridge] 路由进来，
+ * 实时过滤剪贴板与收藏夹条目，点条目即上屏。
+ */
+class ClipboardSearchOverlay(
+    private val ctx: Context,
+    private val theme: Theme,
+    private val service: TrimeInputMethodService,
+    private val windowManager: BoardWindowManager,
+) {
+    private val density = ctx.resources.displayMetrics.density
+
+    private fun dp(value: Int): Int = (value * density + 0.5f).toInt()
+
+    private val barSize = theme.generalStyle.candidateViewHeight + theme.generalStyle.commentHeight
+
+    /** 顶栏高度：在主题栏高的基础上放大，并保证不小于 52dp，方便点击。 */
+    private val barHeight = maxOf(dp(52), (barSize * 1.6f * density).toInt())
+
+    private val textColor = ColorManager.getColor("key_text_color")
+    private val symbolColor = ColorManager.getColor("key_symbol_color")
+
+    private fun isDark(color: Int): Boolean =
+        0.299 * Color.red(color) + 0.587 * Color.green(color) + 0.114 * Color.blue(color) < 140
+
+    /** 主题背景无法解析时的兜底：按文字颜色自动选深/浅背景，保证对比度。 */
+    private val fallbackBackground: Int =
+        if (isDark(textColor)) 0xFF303030.toInt() else 0xFFF7F7F7.toInt()
+
+    /** 浮层背景：优先用主题按键背景（与条目一致），失败则用兜底色。 */
+    private val rootBackground: Drawable =
+        ColorManager.getDecorDrawable("key_back_color", "key_border_color", dp(1), dp(8).toFloat())
+            ?: GradientDrawable().apply {
+                setColor(fallbackBackground)
+                cornerRadius = dp(8).toFloat()
+            }
+
+    /** 浮层高度：约占屏幕 42%，保证不占满整屏、又能看到足够条目。 */
+    val heightPx: Int = (ctx.resources.displayMetrics.heightPixels * 0.42f).toInt()
+
+    private var query: String = ""
+    private var refreshJob: Job? = null
+
+    private val queryView =
+        TextView(ctx).apply {
+            isSingleLine = true
+            ellipsize = TextUtils.TruncateAt.END
+            // 用固定且足够大的字号（20sp），确保在浅色/深色主题下都清晰可见
+            setTextSize(TypedValue.COMPLEX_UNIT_SP, 20f)
+            setTextColor(this@ClipboardSearchOverlay.textColor)
+            setHintTextColor(symbolColor)
+            hint = ctx.getString(R.string.dahi_clipboard_search_hint)
+            gravity = Gravity.CENTER_VERTICAL
+            setPadding(dp(10), 0, dp(10), 0)
+        }
+
+    private val clearButton =
+        ImageView(ctx).apply {
+            setImageResource(R.drawable.ic_outline_cancel_24)
+            setColorFilter(symbolColor)
+            scaleType = ImageView.ScaleType.CENTER_INSIDE
+            contentDescription = "clear"
+            visibility = View.GONE
+            setOnClickListener {
+                query = ""
+                render()
+            }
+        }
+
+    private val backButton =
+        ImageView(ctx).apply {
+            setImageResource(R.drawable.ic_baseline_arrow_back_24)
+            setColorFilter(symbolColor)
+            scaleType = ImageView.ScaleType.CENTER_INSIDE
+            contentDescription = "back"
+            setOnClickListener { exit() }
+        }
+
+    private val searchIcon =
+        ImageView(ctx).apply {
+            setImageResource(R.drawable.ic_baseline_search_24)
+            setColorFilter(symbolColor)
+            scaleType = ImageView.ScaleType.CENTER_INSIDE
+        }
+
+    private class ResultHolder(
+        val ui: ClipboardBeanUi,
+    ) : RecyclerView.ViewHolder(ui.root)
+
+    private val resultAdapter =
+        object : RecyclerView.Adapter<ResultHolder>() {
+            private val items = ArrayList<DatabaseBean>()
+
+            fun submit(list: List<DatabaseBean>) {
+                items.clear()
+                items.addAll(list)
+                notifyDataSetChanged()
+            }
+
+            override fun getItemCount(): Int = items.size
+
+            override fun onCreateViewHolder(
+                parent: ViewGroup,
+                viewType: Int,
+            ): ResultHolder = ResultHolder(ClipboardBeanUi(parent.context, theme))
+
+            override fun onBindViewHolder(
+                holder: ResultHolder,
+                position: Int,
+            ) {
+                val bean = items[position]
+                holder.ui.dragHandle.visibility = View.GONE
+                holder.ui.setBean(bean.text.orEmpty(), bean.pinned)
+                holder.ui.root.setOnClickListener { pick(bean) }
+            }
+        }
+
+    private val listView =
+        RecyclerView(ctx).apply {
+            layoutManager = LinearLayoutManager(ctx)
+            adapter = resultAdapter
+            isVerticalScrollBarEnabled = true
+            clipToPadding = false
+            setPadding(dp(6), dp(6), dp(6), dp(6))
+        }
+
+    val root: View =
+        LinearLayout(ctx).apply {
+            orientation = LinearLayout.VERTICAL
+            setBackground(rootBackground)
+            addView(
+                LinearLayout(ctx).apply {
+                    orientation = LinearLayout.HORIZONTAL
+                    gravity = Gravity.CENTER_VERTICAL
+                    addView(searchIcon, LinearLayout.LayoutParams(dp(barSize), barHeight))
+                    addView(queryView, LinearLayout.LayoutParams(0, barHeight, 1f))
+                    addView(clearButton, LinearLayout.LayoutParams(barHeight, barHeight))
+                    addView(backButton, LinearLayout.LayoutParams(barHeight, barHeight))
+                },
+                LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, barHeight),
+            )
+            addView(
+                listView,
+                LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, 0, 1f),
+            )
+        }
+
+    init {
+        render()
+    }
+
+    /** 键盘提交的文本追加到搜索词。 */
+    fun appendText(text: String) {
+        if (text.isEmpty()) return
+        query += text
+        render()
+    }
+
+    /** 退格：删除搜索词末位。 */
+    fun backspace() {
+        if (query.isEmpty()) return
+        query = query.dropLast(1)
+        render()
+    }
+
+    private fun render() {
+        queryView.text = query
+        clearButton.visibility = if (query.isEmpty()) View.GONE else View.VISIBLE
+        refreshJob?.cancel()
+        refreshJob =
+            service.lifecycleScope.launch {
+                val all = ArrayList<DatabaseBean>()
+                runCatching { all += ClipboardHelper.exportBeans() }
+                runCatching { all += CollectionHelper.exportBeans() }
+                val q = query
+                val filtered =
+                    if (q.isBlank()) {
+                        all
+                    } else {
+                        all.filter { it.text?.contains(q, ignoreCase = true) == true }
+                    }
+                // 按文本去重，避免剪贴板与收藏夹出现重复项
+                val seen = HashSet<String>()
+                resultAdapter.submit(filtered.filter { seen.add(it.text.orEmpty()) })
+            }
+    }
+
+    private fun pick(bean: DatabaseBean) {
+        val text = bean.text ?: return
+        exit()
+        service.commitText(text)
+    }
+
+    /** 退出搜索：清理桥接与浮层，回到键盘。 */
+    fun exit() {
+        refreshJob?.cancel()
+        ClipboardSearchBridge.reset()
+        service.hideBottomOverlay()
+        windowManager.attachWindow(KeyboardWindow)
+    }
+}
