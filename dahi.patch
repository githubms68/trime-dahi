--- /dev/null
+++ b/app/src/main/java/com/osfans/trime/ime/voice/VoiceImagery.kt
@@ -0,0 +1,121 @@
+/*
+ * SPDX-FileCopyrightText: 2026 Rime community
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+package com.osfans.trime.ime.voice
+
+import android.content.SharedPreferences
+import androidx.annotation.StringRes
+import androidx.core.content.edit
+import androidx.preference.PreferenceManager
+import com.osfans.trime.R
+import com.osfans.trime.util.appContext
+
+/**
+ * 声情意象（语音动效）的选项目录。
+ *
+ * 序号即系统默认顺序（1 号为默认值），[id] 为持久化用的稳定标识符。
+ */
+enum class VoiceImageryStyle(
+    val id: String,
+    @StringRes val nameRes: Int,
+    @StringRes val noteRes: Int,
+    /** 快捷切换悬浮窗里的条目文案：名称 + 情绪内核 + 强度。 */
+    @StringRes val pickRes: Int,
+) {
+    GentleFlow("gentle_flow", R.string.dahi_vi_name_gentle_flow, R.string.dahi_vi_note_gentle_flow, R.string.dahi_vi_pick_gentle_flow),
+    QuietGlow("quiet_glow", R.string.dahi_vi_name_quiet_glow, R.string.dahi_vi_note_quiet_glow, R.string.dahi_vi_pick_quiet_glow),
+    StarDots("star_dots", R.string.dahi_vi_name_star_dots, R.string.dahi_vi_note_star_dots, R.string.dahi_vi_pick_star_dots),
+    SlowRipple("slow_ripple", R.string.dahi_vi_name_slow_ripple, R.string.dahi_vi_note_slow_ripple, R.string.dahi_vi_pick_slow_ripple),
+    SmoothSurge("smooth_surge", R.string.dahi_vi_name_smooth_surge, R.string.dahi_vi_note_smooth_surge, R.string.dahi_vi_pick_smooth_surge),
+    ClearRhythm("clear_rhythm", R.string.dahi_vi_name_clear_rhythm, R.string.dahi_vi_note_clear_rhythm, R.string.dahi_vi_pick_clear_rhythm),
+    MistFlow("mist_flow", R.string.dahi_vi_name_mist_flow, R.string.dahi_vi_note_mist_flow, R.string.dahi_vi_pick_mist_flow),
+    RagingWave("raging_wave", R.string.dahi_vi_name_raging_wave, R.string.dahi_vi_note_raging_wave, R.string.dahi_vi_pick_raging_wave),
+    Blank("blank", R.string.dahi_vi_name_blank, R.string.dahi_vi_note_blank, R.string.dahi_vi_pick_blank),
+    ModeRandom("mode_random", R.string.dahi_vi_name_mode_random, R.string.dahi_vi_note_mode_random, R.string.dahi_vi_pick_mode_random),
+    ModeAdaptive("mode_adaptive", R.string.dahi_vi_name_mode_adaptive, R.string.dahi_vi_note_mode_adaptive, R.string.dahi_vi_pick_mode_adaptive),
+    ;
+
+    /** 是否为“绘制型”动效（1~8），随机/自适应都从这 8 套里取。 */
+    val isDrawable: Boolean
+        get() = ordinal <= RagingWave.ordinal
+
+    companion object {
+        fun fromId(id: String?): VoiceImageryStyle? = VoiceImageryStyle.entries.firstOrNull { it.id == id }
+
+        /** 可作为随机/自适应素材的 8 套基础动效。 */
+        val baseStyles: List<VoiceImageryStyle> get() = VoiceImageryStyle.entries.filter { it.isDrawable }
+    }
+}
+
+/**
+ * 声情意象的持久化状态。
+ *
+ * 存放在默认 SharedPreferences（键前缀 `dahi_vi_`），便于随「备份与还原」一起导出；
+ * 备份时由 [com.osfans.trime.data.backup.BackupManager] 单独处理该前缀，不与普通偏好混在一起。
+ */
+object VoiceImagery {
+    const val KEY_PREFIX = "dahi_vi_"
+    private const val KEY_CURRENT = "dahi_vi_current"
+    private const val KEY_ORDER = "dahi_vi_order"
+    private const val KEY_MAX_AMPLITUDE = "dahi_vi_max_amplitude"
+    private const val KEY_SENSITIVITY = "dahi_vi_sensitivity"
+    private const val KEY_TOOLBAR_BUTTON = "dahi_vi_toolbar_button"
+
+    const val DEFAULT_MAX_AMPLITUDE = 100
+    const val DEFAULT_SENSITIVITY = 50
+    const val MIN_MAX_AMPLITUDE = 10
+
+    private val prefs: SharedPreferences
+        get() = PreferenceManager.getDefaultSharedPreferences(appContext)
+
+    fun all(): List<VoiceImageryStyle> = VoiceImageryStyle.entries
+
+    /** 当前选中的动效（非法值回退到 1 号默认项）。 */
+    fun current(): VoiceImageryStyle = VoiceImageryStyle.fromId(prefs.getString(KEY_CURRENT, null)) ?: VoiceImageryStyle.GentleFlow
+
+    fun setCurrent(style: VoiceImageryStyle) {
+        prefs.edit { putString(KEY_CURRENT, style.id) }
+    }
+
+    /** 用户自定义顺序；未出现的条目按默认顺序追加在后面。 */
+    fun order(): List<VoiceImageryStyle> {
+        val saved =
+            prefs
+                .getString(KEY_ORDER, null)
+                ?.split(',')
+                ?.mapNotNull { VoiceImageryStyle.fromId(it) }
+                .orEmpty()
+        val result = saved.distinct()
+        return result + all().filterNot { result.contains(it) }
+    }
+
+    fun setOrder(styles: List<VoiceImageryStyle>) {
+        prefs.edit { putString(KEY_ORDER, styles.joinToString(",") { it.id }) }
+    }
+
+    /** 恢复初始设置：只清除本功能的 `dahi_vi_` 键，不动其它偏好。 */
+    fun resetToDefaults() {
+        val keys = prefs.all.keys.filter { it.startsWith(KEY_PREFIX) }
+        prefs.edit { keys.forEach { remove(it) } }
+    }
+
+    fun maxAmplitude(): Int = prefs.getInt(KEY_MAX_AMPLITUDE, DEFAULT_MAX_AMPLITUDE).coerceIn(MIN_MAX_AMPLITUDE, 100)
+
+    fun setMaxAmplitude(value: Int) {
+        prefs.edit { putInt(KEY_MAX_AMPLITUDE, value.coerceIn(MIN_MAX_AMPLITUDE, 100)) }
+    }
+
+    fun sensitivity(): Int = prefs.getInt(KEY_SENSITIVITY, DEFAULT_SENSITIVITY).coerceIn(0, 100)
+
+    fun setSensitivity(value: Int) {
+        prefs.edit { putInt(KEY_SENSITIVITY, value.coerceIn(0, 100)) }
+    }
+
+    fun toolbarButtonEnabled(): Boolean = prefs.getBoolean(KEY_TOOLBAR_BUTTON, true)
+
+    fun setToolbarButtonEnabled(value: Boolean) {
+        prefs.edit { putBoolean(KEY_TOOLBAR_BUTTON, value) }
+    }
+}
