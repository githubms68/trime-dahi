+/*
+ * SPDX-FileCopyrightText: 2026 Rime community
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+package com.osfans.trime.ime.voice
+
+import android.app.AlertDialog
+import android.content.Context
+import android.widget.Toast
+import com.osfans.trime.R
+
+/**
+ * 声情意象的快捷切换候选悬浮窗。
+ *
+ * 供工具栏按钮与键盘「三点菜单」共用；列表顺序与系统设置页中用户拖动的顺序一致。
+ * 由输入法侧通过 `TrimeInputMethodService.showDialog` 显示，因此这里返回 [AlertDialog] 而非直接 show。
+ */
+object VoiceImageryPickerDialog {
+    fun build(context: Context): AlertDialog {
+        val order = VoiceImagery.order()
+        val labels = order.map { context.getString(it.pickRes) }.toTypedArray()
+        val currentIndex = order.indexOf(VoiceImagery.current())
+        return AlertDialog
+            .Builder(context)
+            .setTitle(R.string.dahi_vi_picker_title)
+            .setSingleChoiceItems(labels, currentIndex) { dialog, which ->
+                val style = order[which]
+                VoiceImagery.setCurrent(style)
+                Toast
+                    .makeText(
+                        context,
+                        context.getString(R.string.dahi_vi_selected_toast, context.getString(style.nameRes)),
+                        Toast.LENGTH_SHORT,
+                    ).show()
+                dialog.dismiss()
+            }.setNegativeButton(android.R.string.cancel, null)
+            .create()
+    }
+}
