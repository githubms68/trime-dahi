index 0000000..cfcd3b2
--- /dev/null
+++ b/build-dahi.sh
@@ -0,0 +1,51 @@
+#!/usr/bin/env bash
+# SPDX-FileCopyrightText: 2026 Rime community
+# SPDX-License-Identifier: GPL-3.0-or-later
+#
+# 一键编译「同文输入法大海版」（自用版，共存包名 com.osfans.trime.dahi）。
+#
+# 依赖：
+#   - JDK 25（与工程 build-logic 要求一致）
+#   - Android SDK（含 build-tools 36、platform 36）
+#   - Android NDK 28.0.13004108、CMake 3.31.6（可用 sdkmanager 安装）
+#   - git（需递归拉取子模块 librime / OpenCC 等）
+#
+# 用法：
+#   ./build-dahi.sh
+#   # 或只编译某个 ABI（更快）：
+#   BUILD_ABI=arm64-v8a ./build-dahi.sh
+set -euo pipefail
+
+export CI_NAME="${CI_NAME:-Dahi Build}"
+# 如 SDK 不在默认位置，请自行设置：
+# export ANDROID_HOME="$HOME/Android/Sdk"
+
+echo ">> 拉取原生依赖（librime / OpenCC / snappy / librime-lua ...，按 v3.3.12 锁定版本）"
+bash script/fetch-dahi-deps.sh
+
+# 可选：确保 NDK / CMake 版本与工程一致（sdkmanager 需在 PATH 中）
+# sdkmanager --install "ndk;28.0.13004108" "cmake;3.31.6"
+
+if [ ! -f keystore.properties ]; then
+  echo ">> 未发现 keystore.properties，自动生成自签名 keystore（仅本机自用）"
+  keytool -genkeypair -v -keystore dahi.keystore -alias dahi \
+    -keyalg RSA -keysize 2048 -validity 10000 \
+    -storepass dahipass -keypass dahipass \
+    -dname "CN=Dahi Trime, OU=Dahi, O=Dahi, L=City, ST=State, C=CN"
+  B64="$(base64 -w0 dahi.keystore 2>/dev/null || base64 dahi.keystore | tr -d '\n')"
+  {
+    echo "keyBase64=$B64"
+    echo "storePassword=dahipass"
+    echo "keyAlias=dahi"
+    echo "keyPassword=dahipass"
+  } > keystore.properties
+fi
+
+echo ">> 开始编译 :app:assembleRelease"
+make release
+
+echo ">> 完成。产物位于： app/build/outputs/apk/release/"
+ls -l app/build/outputs/apk/release/ || true
+echo
+echo "提示：现代手机请安装 arm64-v8a 版本；旧机型选 armeabi-v7a。"
+echo "     安装包名：com.osfans.trime.dahi（可与原版同文共存）。"
diff --git a/script/fetch-dahi-deps.sh b/script/fetch-dahi-deps.sh
new file mode 100755
index 0000000..be284bf
--- /dev/null
+++ b/script/fetch-dahi-deps.sh
@@ -0,0 +1,45 @@
+#!/usr/bin/env bash
+# SPDX-FileCopyrightText: 2026 Rime community
+# SPDX-License-Identifier: GPL-3.0-or-later
+#
+# 按「同文输入法 v3.3.12」锁定的提交号拉取原生依赖。
+#
+# 背景：本目录在官方仓库里是 git 子模块（submodule）。若你把源码以普通文件方式
+# 上传到 GitHub（网页/GitHub Desktop），子模块的"锁定信息"会丢失，导致
+# `git submodule update` 拉不到任何内容、编译失败。
+# 本脚本用固定的 commit 号直接 git clone，因此**不依赖子模块元数据**，任何方式上传都能用。
+#
+# 用法（在工程根目录执行）：
+#   bash script/fetch-dahi-deps.sh
+set -euo pipefail
+
+fetch() { # <url> <sha> <path>
+  local url="$1" sha="$2" path="$3"
+  if [ -d "$path/.git" ]; then
+    echo ">> [已存在，跳过] $path"
+    return 0
+  fi
+  echo ">> 拉取 $path @ ${sha:0:10}"
+  rm -rf "$path"
+  mkdir -p "$(dirname "$path")"
+  git clone --quiet "$url" "$path"
+  git -C "$path" checkout --quiet --detach "$sha"
+  git -C "$path" submodule update --init --recursive --quiet
+}
+
+# ---- 原生库 (app/src/main/jni) ----
+fetch https://github.com/BYVoid/OpenCC.git           907bfcbbd3aae86ff04bc8eaca67c8af03108ddf app/src/main/jni/OpenCC
+fetch https://github.com/google/snappy.git           32ded457c0b1fe78ceb8397632c416568d6714a0 app/src/main/jni/snappy
+fetch https://github.com/rime/librime.git            33e78140250125871856cdc5b42ddc6a5fcd3cd4 app/src/main/jni/librime
+fetch https://github.com/hchunhui/librime-lua.git    68f9c364a2d25a04c7d4794981d7c796b05ab627 app/src/main/jni/librime-lua
+fetch https://github.com/hchunhui/librime-lua.git    9c53b362229766a97b83683b9541c46679118a90 app/src/main/jni/librime-lua-deps
+fetch https://github.com/lotem/librime-octagram.git  bd12863f45fbbd5c7db06d5ec8be8987b10253bf app/src/main/jni/librime-octagram
+fetch https://github.com/rime/librime-predict.git    67c2881914a0242fc14ec7d6877782771b75800c app/src/main/jni/librime-predict
+
+# ---- Rime 方案数据 (app/data/rime) ----
+fetch https://github.com/rime/rime-prelude.git       3803f09458072e03b9ed396692ce7e1d35c88c95 app/data/rime/prelude
+fetch https://github.com/rime/rime-luna-pinyin.git   46acf03142c12b5aeed7002675046bf7255eed35 app/data/rime/luna-pinyin
+fetch https://github.com/rime/rime-stroke.git        7c9874c6b2e0b94947653e9a7de6f99623ff27e4 app/data/rime/stroke
+fetch https://github.com/rime/rime-essay.git         0766c929ec3e578c2c80861e988decd3703a1c3d app/data/rime/essay
+
+echo ">> 原生依赖就绪。"
