@@ -118,6 +118,30 @@ object ClipboardHelper :
 
     fun allBeans() = clbDao.allBeans()
 
+    /** 导出全部条目（用于加密备份）。 */
+    suspend fun exportBeans(): List<DatabaseBean> = clbDao.getAll()
+
+    /** 用备份数据整体替换当前条目（还原）。 */
+    suspend fun restoreBeans(beans: List<DatabaseBean>) {
