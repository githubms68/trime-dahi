@@ -0,0 +1,587 @@
+/*
+ * SPDX-FileCopyrightText: 2026 Rime community
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+package com.osfans.trime.ime.voice
+
+import android.content.Context
+import android.graphics.Canvas
+import android.graphics.Color
+import android.graphics.LinearGradient
+import android.graphics.Paint
+import android.graphics.Path
+import android.graphics.RadialGradient
+import android.graphics.Shader
+import android.util.AttributeSet
+import android.view.View
+import androidx.annotation.ColorInt
+import kotlin.math.abs
+import kotlin.math.ln
+import kotlin.math.max
+import kotlin.math.min
+import kotlin.math.roundToInt
+import kotlin.math.sin
+import kotlin.random.Random
+
+/**
+ * 声情意象的实时动效视图。
+ *
+ * 对外 API 与原有波形视图保持一致（[start] / [stop] / [updateAmplitude] / [setWaveformColor]），
+ * 额外通过 [setStyle] / [setMaxAmplitude] / [setSensitivity] 选择动效与参数。
+ *
+ * 所有动效以键盘画面**垂直中线**为基准绘制；音量来自语音识别客户端推送的振幅流，
+ * 振幅上限由「最大振动幅度上限」统一约束（拉满时接近满屏）。自适应（[VoiceImageryStyle.ModeAdaptive]）
+ * 用「音量 + 音量变化速率」近似活跃度，并带滞后与平滑过渡，避免频繁闪动。
+ */
+class VoiceImageryView @JvmOverloads constructor(
+    context: Context,
+    attrs: AttributeSet? = null,
+    defStyleAttr: Int = 0,
+) : View(context, attrs, defStyleAttr) {
+
+    private companion object {
+        const val FRAME_DELAY_MS = 33L
+        const val AMPLITUDE_GAIN = 1.6
+        const val AMPLITUDE_LOG_K = 18.0
+
+        /** 音量拉满时，波形相对中线的半振幅约占画面高度的比例（0.46 → 峰谷接近满屏）。 */
+        const val MAX_AMPLITUDE_RATIO = 0.46f
+
+        const val BAR_COUNT = 40
+        const val DOT_COLUMNS = 18
+        const val DOT_ROWS = 3
+        const val MAX_PARTICLES = 140
+        const val MAX_RINGS = 8
+        const val TWO_PI = 6.2831855f
+
+        /** 自适应：两次切换之间的最小间隔，避免来回抖动。 */
+        const val ADAPTIVE_DWELL_SEC = 0.9f
+
+        /** 自适应：一次过渡的时长（秒）。 */
+        const val ADAPTIVE_FADE_SEC = 0.45f
+    }
+
+    private val paint = Paint(Paint.ANTI_ALIAS_FLAG).apply { strokeCap = Paint.Cap.ROUND }
+    private val path = Path()
+    private val random = Random(System.currentTimeMillis())
+
+    @ColorInt
+    private var lineColor: Int = Color.WHITE
+
+    private var maxAmplitudeScale = 1f
+    private var sensitivity = 0.5f
+
+    private var style: VoiceImageryStyle = VoiceImageryStyle.GentleFlow
+
+    /** 「随遇随机」在单次语音会话内固定使用的基础动效。 */
+    private var sessionBase: VoiceImageryStyle = VoiceImageryStyle.GentleFlow
+
+    /** 「声随情迁」的过渡状态：从 [adaptiveStage] 过渡到 [adaptiveTarget]。 */
+    private var adaptiveStage = 0
+    private var adaptiveTarget = 0
+    private var adaptiveMix = 1f
+    private var lastAdaptiveSwitch = -10f
+
+    private var active = false
+    private var blankOnly = false
+    private var time = 0f
+    private var targetVolume = 0f
+    private var prevVolume = 0f
+    private var amplitude = 0f
+    private var rateEma = 0f
+    private var activity = 0f
+
+    private val levels = FloatArray(BAR_COUNT)
+    private val particles = ArrayList<Particle>()
+    private val rings = ArrayList<Ring>()
+    private var particleAcc = 0f
+    private var ringAcc = 0f
+
+    private class Particle(
+        var x: Float,
+        var y: Float,
+        var vx: Float,
+        var vy: Float,
+        var life: Float,
+        var size: Float,
+    )
+
+    private class Ring(
+        var x: Float,
+        var y: Float,
+        var radius: Float,
+        var maxRadius: Float,
+        var strength: Float,
+    )
+
+    private val frameRunnable =
+        object : Runnable {
+            override fun run() {
+                if (!active) return
+                advance(FRAME_DELAY_MS / 1000f)
+                invalidate()
+                postDelayed(this, FRAME_DELAY_MS)
+            }
+        }
+
+    fun setWaveformColor(@ColorInt color: Int) {
+        lineColor = color
+        invalidate()
+    }
+
+    fun setMaxAmplitude(percent: Int) {
+        maxAmplitudeScale = percent.coerceIn(10, 100) / 100f
+    }
+
+    fun setSensitivity(percent: Int) {
+        sensitivity = percent.coerceIn(0, 100) / 100f
+    }
+
+    fun setStyle(id: String) {
+        val next = VoiceImageryStyle.fromId(id) ?: VoiceImageryStyle.GentleFlow
+        if (next == style) return
+        style = next
+        prepareSession()
+        invalidate()
+    }
+
+    fun updateAmplitude(amplitude: Float) {
+        if (!active) return
+        targetVolume = amplitudeToVolume(amplitude)
+    }
+
+    fun start() {
+        if (active) return
+        active = true
+        prepareSession()
+        if (blankOnly || visualTargets().isEmpty()) {
+            invalidate()
+            return
+        }
+        postDelayed(frameRunnable, FRAME_DELAY_MS)
+    }
+
+    fun stop() {
+        if (!active) return
+        active = false
+        removeCallbacks(frameRunnable)
+        levels.fill(0f)
+        particles.clear()
+        rings.clear()
+        particleAcc = 0f
+        ringAcc = 0f
+        amplitude = 0f
+        targetVolume = 0f
+        prevVolume = 0f
+        rateEma = 0f
+        activity = 0f
+        invalidate()
+    }
+
+    override fun onVisibilityChanged(
+        changedView: View,
+        visibility: Int,
+    ) {
+        super.onVisibilityChanged(changedView, visibility)
+        if (changedView == this && visibility != View.VISIBLE) stop()
+    }
+
+    override fun onDetachedFromWindow() {
+        super.onDetachedFromWindow()
+        stop()
+    }
+
+    // ============================================================
+    //  会话准备与状态推进
+    // ============================================================
+
+    private fun prepareSession() {
+        sessionBase =
+            when (style) {
+                VoiceImageryStyle.ModeRandom -> VoiceImageryStyle.baseStyles.random()
+                else -> if (style.isDrawable) style else VoiceImageryStyle.GentleFlow
+            }
+        blankOnly = style == VoiceImageryStyle.Blank
+        adaptiveStage = 0
+        adaptiveTarget = 0
+        adaptiveMix = 1f
+        lastAdaptiveSwitch = -10f
+        activity = 0f
+    }
+
+    /** 当前音量（受「最大振幅上限」约束）。 */
+    private fun ampValue(): Float = (amplitude * maxAmplitudeScale).coerceIn(0f, 1f)
+
+    /** 相对中线的半振幅像素值：拉满时接近整个画面高度。 */
+    private fun ampHeight(): Float = height * MAX_AMPLITUDE_RATIO * ampValue()
+
+    private fun advance(dt: Float) {
+        time += dt
+        val attack = 0.5f
+        val release = 0.12f
+        amplitude += (targetVolume - amplitude) * (if (targetVolume > amplitude) attack else release)
+        amplitude = amplitude.coerceIn(0f, 1f)
+
+        val dv = abs(targetVolume - prevVolume)
+        prevVolume = targetVolume
+        rateEma = rateEma * 0.9f + dv * 0.1f
+
+        // 活跃度：以音量为主，声音变化速率为辅；再强低通，保证整体迟钝、不抖
+        val raw = (0.72f * amplitude + 0.28f * (rateEma * 6f).coerceAtMost(1f)).coerceIn(0f, 1f)
+        val gain = 0.45f + 0.85f * sensitivity
+        val targetActivity = (((raw - 0.5f) * gain) + 0.5f).coerceIn(0f, 1f)
+        activity += (targetActivity - activity) * 0.05f
+
+        val amp = ampValue()
+        advanceLevels(amp)
+        advanceRings(dt, amp)
+        advanceParticles(dt, amp)
+        if (style == VoiceImageryStyle.ModeAdaptive) updateAdaptive(dt)
+    }
+
+    /** 「声随情迁」：活跃度跨档时才切换（带滞后），并在两套动效之间平滑过渡，避免同时出现多个动效。 */
+    private fun updateAdaptive(dt: Float) {
+        val count = VoiceImageryStyle.baseStyles.size
+        val desired = (activity * (count - 1)).roundToInt().coerceIn(0, count - 1)
+        if (desired != adaptiveTarget && time - lastAdaptiveSwitch > ADAPTIVE_DWELL_SEC) {
+            adaptiveStage = if (adaptiveMix >= 1f) adaptiveTarget else adaptiveStage
+            adaptiveTarget = desired
+            adaptiveMix = 0f
+            lastAdaptiveSwitch = time
+        }
+        adaptiveMix = (adaptiveMix + dt / ADAPTIVE_FADE_SEC).coerceAtMost(1f)
+    }
+
+    private fun advanceLevels(amp: Float) {
+        for (i in levels.indices) {
+            val wave = (waveSin(time * 4.5f + i * 0.4f) + 1f) / 2f
+            val center = 1f - 0.45f * abs(i / (levels.size - 1f) * 2f - 1f)
+            val level = amp * (0.3f + 0.7f * wave) * center
+            levels[i] = max(levels[i] * 0.55f, level)
+        }
+    }
+
+    private fun advanceRings(
+        dt: Float,
+        amp: Float,
+    ) {
+        ringAcc += dt * (0.7f + 2.8f * amp)
+        val maxRadius = max(dp(40f), min(width, height) * (0.3f + 0.6f * amp))
+        while (ringAcc >= 1f && rings.size < MAX_RINGS) {
+            ringAcc -= 1f
+            rings.add(
+                Ring(
+                    x = width / 2f,
+                    y = height / 2f,
+                    radius = 0f,
+                    maxRadius = maxRadius,
+                    strength = 0.5f + 0.5f * amp,
+                ),
+            )
+        }
+        val speed = max(dp(36f), min(width, height) * (0.3f + 0.85f * amp))
+        rings.forEach { it.radius += speed * dt }
+        rings.removeAll { it.radius > it.maxRadius }
+    }
+
+    private fun advanceParticles(
+        dt: Float,
+        amp: Float,
+    ) {
+        particleAcc += dt * (18f + 70f * amp)
+        while (particleAcc >= 1f && particles.size < MAX_PARTICLES) {
+            particleAcc -= 1f
+            val angle = random.nextFloat() * TWO_PI
+            val speed = (dp(20f) + dp(90f) * (0.3f + 0.7f * amp)) * (0.35f + 0.65f * random.nextFloat())
+            particles.add(
+                Particle(
+                    x = width / 2f + (random.nextFloat() - 0.5f) * width * 0.55f,
+                    y = height / 2f + (random.nextFloat() - 0.5f) * height * 0.45f,
+                    vx = waveSin(angle) * speed,
+                    vy = waveSin(angle * 0.5f + 1.3f) * speed * 0.6f,
+                    life = 1f,
+                    size = dp(1.6f) + dp(3.4f) * random.nextFloat(),
+                ),
+            )
+        }
+        particles.forEach {
+            it.x += it.vx * dt
+            it.y += it.vy * dt
+            it.life -= dt * 0.5f
+        }
+        particles.removeAll {
+            it.life <= 0f || it.y < -dp(24f) || it.y > height + dp(24f) || it.x < -dp(24f) || it.x > width + dp(24f)
+        }
+    }
+
+    // ============================================================
+    //  绘制
+    // ============================================================
+
+    private fun visualTargets(): List<Pair<VoiceImageryStyle, Float>> = when (style) {
+        VoiceImageryStyle.ModeRandom -> listOf(sessionBase to 1f)
+        VoiceImageryStyle.ModeAdaptive -> {
+            val base = VoiceImageryStyle.baseStyles
+            val from = base[adaptiveStage.coerceIn(0, base.size - 1)]
+            val to = base[adaptiveTarget.coerceIn(0, base.size - 1)]
+            if (adaptiveMix >= 1f || from == to) {
+                listOf(to to 1f)
+            } else {
+                listOf(from to (1f - adaptiveMix), to to adaptiveMix)
+            }
+        }
+        VoiceImageryStyle.Blank -> emptyList()
+        else -> listOf(style to 1f)
+    }
+
+    override fun onDraw(canvas: Canvas) {
+        super.onDraw(canvas)
+        if (width <= 0 || height <= 0) return
+        val targets = visualTargets()
+        if (targets.isEmpty()) return
+
+        paint.shader = null
+        paint.color = lineColor
+        paint.alpha = 255
+        targets.forEach { (target, weight) ->
+            if (weight <= 0.02f) return@forEach
+            when (target) {
+                VoiceImageryStyle.GentleFlow -> drawGentleFlow(canvas, weight)
+                VoiceImageryStyle.QuietGlow -> drawQuietGlow(canvas, weight)
+                VoiceImageryStyle.StarDots -> drawStarDots(canvas, weight)
+                VoiceImageryStyle.SlowRipple -> drawSlowRipple(canvas, weight)
+                VoiceImageryStyle.SmoothSurge -> drawSmoothSurge(canvas, weight)
+                VoiceImageryStyle.ClearRhythm -> drawClearRhythm(canvas, weight)
+                VoiceImageryStyle.MistFlow -> drawMistFlow(canvas, weight)
+                VoiceImageryStyle.RagingWave -> drawRagingWave(canvas, weight)
+                else -> Unit
+            }
+        }
+        paint.shader = null
+        paint.alpha = 255
+    }
+
+    /** 1. 清纹徐流：**只有一条**水平细线，位于键盘垂直中线，随音量做垂直波浪形变。 */
+    private fun drawGentleFlow(
+        canvas: Canvas,
+        weight: Float,
+    ) {
+        val w = width.toFloat()
+        val cy = height / 2f
+        val a = ampHeight()
+        paint.style = Paint.Style.STROKE
+        paint.strokeWidth = dp(2f)
+        paint.alpha = alphaOf(0.85f * weight)
+        path.reset()
+        var x = 0f
+        val step = max(2f, w / 72f)
+        while (x <= w) {
+            val u = x / w
+            val y =
+                cy +
+                    waveSin(TWO_PI * 1.15f * u + time * 1.2f) * a +
+                    waveSin(TWO_PI * 2.7f * u - time * 0.7f) * a * 0.16f
+            if (x == 0f) path.moveTo(x, y) else path.lineTo(x, y)
+            x += step
+        }
+        canvas.drawPath(path, paint)
+    }
+
+    /** 2. 静息沉光：键盘中心区域的动态渐变光晕，缓慢而明显地呼吸。 */
+    private fun drawQuietGlow(
+        canvas: Canvas,
+        weight: Float,
+    ) {
+        val cx = width / 2f
+        val cy = height / 2f
+        val amp = ampValue()
+        val breath = 0.5f + 0.5f * waveSin(time * 0.85f)
+        val maxR = min(width, height) * 0.5f
+        val radius = (maxR * (0.34f + 0.6f * breath) * (0.6f + 0.4f * amp)).coerceAtLeast(dp(10f))
+        val a = ((0.25f + 0.55f * breath) * (0.55f + 0.45f * amp) * weight).coerceIn(0f, 1f)
+        paint.style = Paint.Style.FILL
+        paint.alpha = alphaOf(a)
+        paint.shader =
+            RadialGradient(
+                cx,
+                cy,
+                radius,
+                lineColor,
+                lineColor and 0x00FFFFFF,
+                Shader.TileMode.CLAMP,
+            )
+        canvas.drawCircle(cx, cy, radius, paint)
+        paint.shader = null
+    }
+
+    /** 3. 星星点点：三排光点阵列，**中间一排正好落在键盘垂直中线**。 */
+    private fun drawStarDots(
+        canvas: Canvas,
+        weight: Float,
+    ) {
+        val amp = ampValue()
+        val w = width.toFloat()
+        val cy = height / 2f
+        val rowGap = height * 0.13f
+        val dot = dp(2.2f) + dp(2.6f) * amp
+        paint.style = Paint.Style.FILL
+        for (r in 0 until DOT_ROWS) {
+            val baseY = cy + (r - (DOT_ROWS - 1) / 2f) * rowGap
+            for (c in 0 until DOT_COLUMNS) {
+                val fx = (c + 0.5f) / DOT_COLUMNS
+                val phase = ((r * 17 + c * 7) % 13) / 13f * TWO_PI
+                val twinkle = 0.5f + 0.5f * waveSin(time * 2.4f + phase)
+                val center = 1f - 0.55f * abs(fx * 2f - 1f)
+                val mag = (0.3f + 0.7f * amp) * twinkle * center
+                val x = w * fx
+                val y = baseY - height * 0.04f * mag
+                paint.alpha = alphaOf((0.16f + 0.74f * mag) * weight)
+                canvas.drawCircle(x, y, dot * (0.55f + 0.45f * mag), paint)
+            }
+        }
+    }
+
+    /** 4. 环漪悠漾：以键盘中心为源点的同心圆涟漪，向外扩散并衰减。 */
+    private fun drawSlowRipple(
+        canvas: Canvas,
+        weight: Float,
+    ) {
+        paint.style = Paint.Style.STROKE
+        rings.forEach {
+            val t = (it.radius / it.maxRadius).coerceIn(0f, 1f)
+            val fade = (1f - t) * (1f - t)
+            paint.strokeWidth = dp(2.6f) + dp(2.4f) * it.strength
+            paint.alpha = alphaOf(fade * 0.8f * it.strength * weight)
+            canvas.drawCircle(it.x, it.y, it.radius, paint)
+        }
+    }
+
+    /** 5. 碧浪腾舒：多层平滑正弦曲线（围绕中线），曲线下方低透明度填充。 */
+    private fun drawSmoothSurge(
+        canvas: Canvas,
+        weight: Float,
+    ) {
+        val w = width.toFloat()
+        val cy = height / 2f
+        val bottom = height.toFloat()
+        val layers = 3
+        val step = max(2f, w / 64f)
+        for (i in 0 until layers) {
+            val lf = (i + 1).toFloat() / layers
+            val baseY = cy + (i - (layers - 1) / 2f) * height * 0.1f
+            val waveAmp = ampHeight() * (0.6f + 0.4f * lf)
+            val freq = 0.9f + 0.5f * i
+            val sampleY = { x: Float ->
+                val u = x / w
+                baseY +
+                    waveSin(TWO_PI * freq * u + time * (1.1f + 0.4f * i)) * waveAmp +
+                    waveSin(TWO_PI * freq * 2.3f * u + time * 1.7f) * waveAmp * 0.25f
+            }
+            path.reset()
+            var x = 0f
+            while (x <= w) {
+                val y = sampleY(x)
+                if (x == 0f) path.moveTo(x, y) else path.lineTo(x, y)
+                x += step
+            }
+            path.lineTo(w, bottom)
+            path.lineTo(0f, bottom)
+            path.close()
+            paint.style = Paint.Style.FILL
+            paint.alpha = alphaOf(0.09f * lf * weight)
+            canvas.drawPath(path, paint)
+
+            path.reset()
+            x = 0f
+            while (x <= w) {
+                val y = sampleY(x)
+                if (x == 0f) path.moveTo(x, y) else path.lineTo(x, y)
+                x += step
+            }
+            paint.style = Paint.Style.STROKE
+            paint.strokeWidth = dp(2.2f)
+            paint.alpha = alphaOf((0.4f + 0.4f * lf) * weight)
+            canvas.drawPath(path, paint)
+        }
+    }
+
+    /** 6. 明律铿锵：等宽细竖条频谱，整体居中，中间权重略高。 */
+    private fun drawClearRhythm(
+        canvas: Canvas,
+        weight: Float,
+    ) {
+        val w = width.toFloat()
+        val cy = height / 2f
+        val maxHalf = height * MAX_AMPLITUDE_RATIO
+        val step = w / BAR_COUNT
+        paint.style = Paint.Style.STROKE
+        paint.strokeWidth = max(dp(2f), step * 0.45f)
+        for (i in levels.indices) {
+            val x = step * i + step / 2f
+            val center = 1f - 0.45f * abs(i / (levels.size - 1f) * 2f - 1f)
+            val half = max(paint.strokeWidth, maxHalf * levels[i] * center)
+            paint.alpha = alphaOf((0.22f + 0.72f * levels[i]) * weight)
+            canvas.drawLine(x, cy - half, x, cy + half, paint)
+        }
+    }
+
+    /** 7. 迷雾萦回：大量微小粒子自中心区域向外缓慢、无序流动，铺开整个画面中部。 */
+    private fun drawMistFlow(
+        canvas: Canvas,
+        weight: Float,
+    ) {
+        paint.style = Paint.Style.FILL
+        particles.forEach {
+            paint.alpha = alphaOf(it.life * 0.55f * weight)
+            canvas.drawCircle(it.x, it.y, it.size * (0.5f + 0.5f * it.life), paint)
+        }
+    }
+
+    /** 8. 海浪怒吼：多层半透明宽笔画叠加，围绕中线起伏，模拟模糊流体噪波。 */
+    private fun drawRagingWave(
+        canvas: Canvas,
+        weight: Float,
+    ) {
+        val amp = ampValue()
+        val w = width.toFloat()
+        val cy = height / 2f
+        val layers = 6
+        for (i in 0 until layers) {
+            val lf = (i + 1).toFloat() / layers
+            val baseY = cy + (i - (layers - 1) / 2f) * height * 0.055f
+            val waveAmp = ampHeight() * (0.3f + 0.7f * lf) * (0.35f + 0.65f * amp)
+            val p1 = time * (1.6f + 0.55f * i)
+            val p2 = time * (2.6f + 0.7f * i) + i * 1.7f
+            path.reset()
+            var x = 0f
+            val step = max(2f, w / 64f)
+            while (x <= w) {
+                val u = x / w
+                val y =
+                    baseY +
+                        waveSin(TWO_PI * (1.3f + 0.4f * i) * u + p1) * waveAmp +
+                        waveSin(TWO_PI * (3.1f + 0.7f * i) * u + p2) * waveAmp * 0.45f +
+                        waveSin(TWO_PI * (6.3f + i) * u + p1 * 1.8f) * waveAmp * 0.22f
+                if (x == 0f) path.moveTo(x, y) else path.lineTo(x, y)
+                x += step
+            }
+            paint.style = Paint.Style.STROKE
+            paint.strokeWidth = dp(3f + 2f * i)
+            paint.alpha = alphaOf((0.07f + 0.08f * lf) * (0.45f + 0.55f * amp) * weight)
+            canvas.drawPath(path, paint)
+        }
+    }
+
+    private fun alphaOf(value: Float): Int = (value.coerceIn(0f, 1f) * 255f).toInt().coerceIn(0, 255)
+
+    private fun dp(value: Float): Float = value * resources.displayMetrics.density
+
+    private fun waveSin(value: Float): Float = sin(value.toDouble()).toFloat()
+
+    private fun amplitudeToVolume(amplitude: Float): Float {
+        val a = (amplitude.coerceIn(0f, 1f).toDouble() * AMPLITUDE_GAIN).coerceIn(0.0, 1.0)
+        val mapped = ln(1.0 + AMPLITUDE_LOG_K * a) / ln(1.0 + AMPLITUDE_LOG_K)
+        return mapped.toFloat().coerceIn(0f, 1f)
+    }
+}
